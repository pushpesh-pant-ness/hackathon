# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- AWS / Bedrock ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional if using temporary credentials:
AWS_SESSION_TOKEN=

# --- Bedrock model IDs ---
BEDROCK_CHAT_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMENSIONS=1024

# --- Crawl limits (Dev A) ---
MAX_PAGES=20
MAX_DEPTH=3
REQUEST_TIMEOUT=10
MAX_RESPONSE_BYTES=2000000
CRAWL_DELAY_SECONDS=0.5
USER_AGENT=HackathonRAGBot/0.1 (+https://example.com/bot)

# --- Storage ---
DATA_DIR=data/sessions

# --- Chunking (Dev A) ---
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
# Copy this file to .env and fill in real values. Never commit the real .env.

# --- AWS Bedrock credentials (kept server-side only, never sent to Streamlit/browser) ---
ACCESS_KEY_ID=changeme
SECRET_ACCESS_KEY=changeme
AWS_REGION=us-east-1

# --- Bedrock model IDs ---
NOVA_MODEL_ID=amazon.nova-pro-v1:0
TITAN_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024
# "bedrock" (real Titan calls) or "local" (deterministic offline hash-embedding for
# tests/fixture-building without live AWS access).
EMBEDDING_BACKEND=bedrock

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=10
RETRIEVAL_TOP_K_SELECTED=5
EVIDENCE_SIMILARITY_THRESHOLD=0.35

# --- Crawl limits (owned by Dev A, listed here for a single shared config surface) ---
MAX_PAGES=20
MAX_CRAWL_DEPTH=3

# --- Storage paths ---
DATA_DIR=data
SESSIONS_DIR=data/sessions
SQLITE_PATH=data/app.db

# --- Backend/UI wiring ---
BACKEND_URL=http://localhost:8000
